{
  "firestore": { "rules": "firestore.rules" },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "*.log"]
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "functions/**", "node_modules/**", ".git/**", "*.test.js", "PUSH-SETUP.md", "store-listing/**", "uploads/**", "ios-frame.jsx"],
    "rewrites": [{ "source": "/", "destination": "/index.html" }]
  }
}
