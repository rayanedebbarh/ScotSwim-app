node_modules/
www/
# The repo root's .gitignore blanket-excludes package-lock.json (added
# for an unrelated earlier npm experiment at the repo root) — this one
# is needed so CI's `npm ci` gets a real, reproducible lockfile.
!package-lock.json
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/captures/
# The release signing keystore — CI decodes it from a secret at build time
# (see .github/workflows/android-release.yml); it must never be committed.
android/app/*.keystore
android/app/*.jks
ios/App/Pods/
ios/App/build/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App/public/
